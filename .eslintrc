parser: "@babel/eslint-parser"
parserOptions:
  requireConfigFile: false
extends: airbnb

rules:
  max-len: [0, 100]
  no-constant-condition: 0
  arrow-body-style: [1, "as-needed"]
  comma-dangle: [2, "never"]
  padded-blocks: [0, "never"]
  no-unused-vars: [2, {vars: all, args: none}]
  # same as i18next-mf2: the path walker and the option merging write to their arguments on purpose
  no-param-reassign: 0
  no-continue: 0
  import/extensions: 0
  # airbnb also forbids for...of, which this code uses
  no-restricted-syntax: [2, ForInStatement, LabeledStatement, WithStatement]
  react/prop-types:
    - 0
    - ignore: #coming from hoc
      - location
      - fields
      - handleSubmit

globals:
  expect: false
